{
  "schemaVersion": 1,
  "id": "anythingbutfish",
  "version": "${version}",
  "name": "AnythingButFish",
  "description": "Replaces vanilla fishing loot with completely random items, entities, and experience orbs. Who knows what you'll reel in next?",
  "authors": [
    "LithumC"
  ],
  "contact": {
    "sources": "https://github.com/lithumc/AnythingButFishMod"
  },
  "license": "Unlicense",
  "icon": "assets/anythingbutfish/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lithumc.AnythingButFish"
    ],
    "client": [
      "com.lithumc.client.anythingbutfishClient"
    ],
    "modmenu": [
      "com.lithumc.client.AbfModMenuIntegration"
    ]
  },
  "mixins": [
    "anythingbutfish.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "cloth-config": ">=8.0.0",
    "modmenu": "*"
  }
}