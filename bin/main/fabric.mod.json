  "authors": [
    "LithumC"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/anything-but-fish",
    "sources": "https://github.com/Lithum-12/Anything-but-Fish",
    "issues": "https://github.com/Lithum-12/Anything-but-Fish/issues"
  },

  "license": "LGPLv3",
  "icon": "assets/anythingbutfish/icon.png",

  "environment": "*",
  "entrypoints": {
