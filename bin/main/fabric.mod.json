      "com.lithumc.AnythingButFish"
    ],
    "client": [
      "com.lithumc.client.anythingbutfishClient"
    ],
    "modmenu": [
      "com.lithumc.client.AbfModMenuIntegration"
    ]
  },
  "mixins": [
    "anythingbutfish.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.15.0",
